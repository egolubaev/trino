{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Health, adoption and cost of automatic CTE materialization (trino.cte:name=CteMaterializationStats). PromQL uses case-insensitive __name__ regexes so it works regardless of how the JMX exporter renders the MBean name (folded into the metric name or into a label).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["trino", "cte", "materialization"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Trino — CTE Materialization",
  "uid": "trino-cte-materialization",
  "version": 1,
  "weekStart": "",
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Health",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Fallback ratio (materialization attempts → inlined)",
      "description": "Fraction of materialization attempts that failed and fell back to inlining. Should stay at 0.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate({__name__=~\"(?i)trino_cte.*materializationfallbacks.*total.*\"}[$__rate_interval])) / clamp_min(sum(rate({__name__=~\"(?i)trino_cte.*queriesmaterialized.*total.*\"}[$__rate_interval])) + sum(rate({__name__=~\"(?i)trino_cte.*materializationfallbacks.*total.*\"}[$__rate_interval])), 1)"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Outstanding scratch tables (created − dropped)",
      "description": "Created minus dropped. A small transient value (queries mid-flight) is normal; a sustained upward trend means scratch tables are leaking.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 9, "x": 6, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 100 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum({__name__=~\"(?i)trino_cte.*scratchtablescreated.*total.*\"}) - sum({__name__=~\"(?i)trino_cte.*scratchtablesdropped.*total.*\"})",
          "legendFormat": "outstanding"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 4,
      "title": "Errors /s (scratch drop failures, sweep errors)",
      "description": "Both should be flat at zero.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 9, "x": 15, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate({__name__=~\"(?i)trino_cte.*scratchdropfailures.*total.*\"}[$__rate_interval]))",
          "legendFormat": "scratch drop failures"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate({__name__=~\"(?i)trino_cte.*sweeperrors.*total.*\"}[$__rate_interval]))",
          "legendFormat": "sweep errors"
        }
      ]
    },
    {
      "type": "row",
      "id": 5,
      "title": "Adoption & benefit",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 }
    },
    {
      "type": "timeseries",
      "id": 6,
      "title": "Materialized /s (queries & CTEs)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate({__name__=~\"(?i)trino_cte.*queriesmaterialized.*total.*\"}[$__rate_interval]))",
          "legendFormat": "queries materialized"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate({__name__=~\"(?i)trino_cte.*ctesmaterialized.*total.*\"}[$__rate_interval]))",
          "legendFormat": "CTEs materialized"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate({__name__=~\"(?i)trino_cte.*ctesinlinednolocation.*total.*\"}[$__rate_interval]))",
          "legendFormat": "CTEs inlined (no location)"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 7,
      "title": "Estimated repeated-scan rows saved /s",
      "description": "Sum of (references - 1) * source-rows over materialized CTEs with known statistics. The headline 'benefit' signal.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "rps",
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2, "showPoints": "never", "gradientMode": "opacity" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate({__name__=~\"(?i)trino_cte.*estimatedrowssaved.*total.*\"}[$__rate_interval]))",
          "legendFormat": "rows saved/s"
        }
      ]
    },
    {
      "type": "row",
      "id": 8,
      "title": "Cost & maintenance",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 }
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "Scratch CTAS latency (ms)",
      "description": "Wall time of the internal scratch CREATE TABLE statements. If a coordinator does not export percentiles under these names, adjust the regex (AllTime.P50/P95/Max).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max({__name__=~\"(?i)trino_cte.*scratchctastime.*alltime.*p50\"})",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max({__name__=~\"(?i)trino_cte.*scratchctastime.*alltime.*p95\"})",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max({__name__=~\"(?i)trino_cte.*scratchctastime.*alltime.*max\"})",
          "legendFormat": "max"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 10,
      "title": "Sweeper /s (runs & orphans reclaimed)",
      "description": "Orphans dropped > 0 means per-query cleanup is leaking scratch tables that the background sweeper has to reclaim — worth investigating.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate({__name__=~\"(?i)trino_cte.*sweepruns.*total.*\"}[$__rate_interval]))",
          "legendFormat": "sweep runs"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate({__name__=~\"(?i)trino_cte.*orphanscratchdropped.*total.*\"}[$__rate_interval]))",
          "legendFormat": "orphans reclaimed"
        }
      ]
    }
  ]
}
